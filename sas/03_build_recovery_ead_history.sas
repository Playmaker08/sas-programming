/*=============================================================================
  IFRS 9 CREDIT RISK & ECL ENGINE
  03_BUILD_RECOVERY_EAD_HISTORY.SAS

  PHASE 1.3 — RECOVERY CASH FLOWS + REALIZED LGD + REALIZED EAD/CCF TARGETS

  PURPOSE
  -------
  Convert synthetic default events from Phase 1.2 into realistic post-default
  workout cash flows and pre-default EAD development targets.

  DESIGN PRINCIPLES
  -----------------
  1) Recoveries are generated as dated cash flows, not as a random LGD number.
  2) Auto recoveries are collateral-led (repossession/auction + deficiency).
  3) Credit-card / personal-loan recoveries are unsecured collection/settlement
     cash flows spread through time.
  4) Recovery costs are explicit and discounted using account EIR.
  5) Realized LGD is derived from discounted NET recoveries.
  6) Credit-card CCF is derived from observed pre-default drawdown paths.
  7) Recent defaults are flagged as immature to prevent future-information
     leakage in later LGD model development.
  8) All recovery-rate parameters are PROJECT CALIBRATION ASSUMPTIONS, not
     regulatory constants or claims of exact industry recovery rates.

  REQUIRED INPUTS
  ---------------
  INT.DEFAULT_EVENTS
  INT.ACCOUNT_MASTER
  MODEL.MONTHLY_SNAPSHOT

  OUTPUTS
  -------
  INT.DEFAULT_ENRICHED
  INT.RECOVERY_CASHFLOWS
  MODEL.LGD_ABT
  MODEL.LGD_ABT_MATURE
  INT.EAD_TARGET_CANDIDATES
  MODEL.EAD_ABT
  OUT.PHASE13_RECOVERY_SUMMARY
  OUT.PHASE13_EAD_COVERAGE
=============================================================================*/

%include "%sysget(HOME)/sas/00_setup.sas";

/*=============================================================================
  0. PREREQUISITE CHECKS
=============================================================================*/

%macro assert_ds(ds=);
    %local dsid rc;
    %let dsid=%sysfunc(open(&ds.));
    %if &dsid.=0 %then %do;
        %put ERROR: Required data set &ds. does not exist or cannot be opened.;
        %abort cancel;
    %end;
    %let rc=%sysfunc(close(&dsid.));
%mend;

%assert_ds(ds=INT.default_events);
%assert_ds(ds=INT.account_master);
%assert_ds(ds=MODEL.monthly_snapshot);

/* Maximum recovery lag generated by this phase. */
%let RECOVERY_HORIZON_M=18;

/* Defaults need the full recovery horizon before SNAP_END to be considered
   mature for later LGD model development. */
%let LGD_MATURE_CUTOFF=%sysfunc(intnx(month,&SNAP_END.,-&RECOVERY_HORIZON_M.,e));

/* The expression above resolves to a SAS date number.  Keep a readable note. */
%put NOTE: Phase 1.3 LGD mature-default cutoff =
    %sysfunc(putn(&LGD_MATURE_CUTOFF.,date9.));

/*=============================================================================
  1. ENRICH DEFAULT EVENTS WITH CONTRACT / BORROWER ATTRIBUTES
=============================================================================*/

proc sql;
    create table INT.default_enriched as
    select
        d.*,
        a.vehicle_type,
        a.apr,
        a.effective_interest_rate,
        a.original_balance,
        a.gross_annual_income,
        a.debt_to_income,
        a.origination_score,
        a.orig_score_tier,
        a.ltv_orig
    from INT.default_events as d
    left join INT.account_master as a
        on d.account_id=a.account_id
    order by d.account_id;
quit;

/* Hard check: one enriched row per default event. */
proc sql noprint;
    select count(*) into :N_DEFAULTS trimmed from INT.default_events;
    select count(*) into :N_ENRICHED trimmed from INT.default_enriched;
quit;

%if &N_DEFAULTS. ne &N_ENRICHED. %then %do;
    %put ERROR: DEFAULT_ENRICHED row count (&N_ENRICHED.) does not match DEFAULT_EVENTS (&N_DEFAULTS.).;
    %abort cancel;
%end;

/*=============================================================================
  2. GENERATE DATED POST-DEFAULT RECOVERY CASH FLOWS

  IMPORTANT
  ---------
  These are synthetic workout mechanics calibrated to plausible retail-credit
  behavior.  Exact public account-level recovery distributions are generally
  not observable, so the assumptions are deliberately transparent and will be
  sensitivity-tested later.
=============================================================================*/

data INT.recovery_cashflows;
    set INT.default_enriched;

    if _n_=1 then call streaminit(&SEED.+303);

    length recovery_channel $32
           recovery_group $12;

    format default_date cashflow_date date9.
           gross_recovery recovery_cost net_recovery dollar14.2;

    /* Economic stress lowers recovery values and collection success. */
    gdp_recovery=max(-5,min(5,real_gdp_growth));
    recovery_stress_mult=exp(
          -0.055*max(0,unemployment_rate-4.0)
          +0.020*gdp_recovery
    );
    recovery_stress_mult=max(0.72,min(1.12,recovery_stress_mult));

    /* Better score at default modestly improves unsecured collections. */
    score_recovery_mult=exp(0.0025*(score_at_default-570));
    score_recovery_mult=max(0.70,min(1.25,score_recovery_mult));

    /*-------------------------------------------------------------------------
      AUTO LOAN: COLLATERAL-LED WORKOUT

      Mechanics:
        1) repossession + wholesale/auction sale in ~2–5 months
        2) optional deficiency collection several months later

      Gross collateral proceeds are below appraised collateral because of
      liquidation discounts and vehicle condition.  Explicit repo/auction costs
      reduce net recovery.
    -------------------------------------------------------------------------*/
    if product_type='Auto Loan' then do;
        recovery_group='Secured';

        /* Main collateral liquidation. */
        lag_months=ceil(1 + 4*rand('uniform'));   /* 2–5 months */

        sale_factor = 0.66 + 0.29*rand('beta',4.5,3.0);
        sale_factor = sale_factor
                      * recovery_stress_mult
                      * (1 - 0.025*(vehicle_type='Used'));
        sale_factor=max(0.50,min(0.97,sale_factor));

        gross_recovery=max(0,min(balance_at_default,
                                 collateral_value_at_default*sale_factor));

        /* Repo + transport + auction + legal/admin costs. */
        recovery_cost = 500
                        + 0.065*gross_recovery
                        + 350*rand('uniform');
        recovery_cost=max(350,recovery_cost);

        net_recovery=max(0,gross_recovery-recovery_cost);
        cashflow_date=intnx('month',default_date,lag_months,'e');
        recovery_channel='Repossession / auction';
        cashflow_index=1;
        output;

        /* Optional deficiency collections after collateral sale. */
        residual_after_sale=max(0,balance_at_default-net_recovery);
        p_def_collection = 0.56
                           * score_recovery_mult
                           * recovery_stress_mult;
        p_def_collection=max(0.20,min(0.78,p_def_collection));

        if residual_after_sale>250 and rand('uniform')<p_def_collection then do;
            lag_months=min(&RECOVERY_HORIZON_M.,
                           ceil(7 + 10*rand('uniform'))); /* ~8–17m */

            def_recovery_rate = 0.03
                                + 0.20*rand('beta',2.0,5.5);
            def_recovery_rate = def_recovery_rate
                                * score_recovery_mult
                                * recovery_stress_mult;
            def_recovery_rate=max(0.01,min(0.28,def_recovery_rate));

            gross_recovery=residual_after_sale*def_recovery_rate;
            recovery_cost=0.18*gross_recovery + 75;
            net_recovery=max(0,gross_recovery-recovery_cost);
            cashflow_date=intnx('month',default_date,lag_months,'e');
            recovery_channel='Deficiency collection';
            cashflow_index=2;
            output;
        end;
    end;

    /*-------------------------------------------------------------------------
      CREDIT CARD: UNSECURED COLLECTION / SETTLEMENT

      Ultimate gross recovery is generated first, then distributed over dated
      cash flows.  A meaningful zero-recovery mass is retained.
    -------------------------------------------------------------------------*/
    else if product_type='Credit Card' then do;
        recovery_group='Unsecured';

        p_any_recovery = 0.69
                         * score_recovery_mult
                         * recovery_stress_mult
                         * exp(-0.000015*max(0,balance_at_default-4000));
        p_any_recovery=max(0.32,min(0.84,p_any_recovery));

        if rand('uniform') < p_any_recovery then do;
            gross_rec_rate = 0.035 + 0.34*rand('beta',2.2,6.8);
            gross_rec_rate = gross_rec_rate
                             * score_recovery_mult
                             * recovery_stress_mult;
            gross_rec_rate=max(0.015,min(0.42,gross_rec_rate));

            ultimate_gross=min(balance_at_default,
                               balance_at_default*gross_rec_rate);

            /* Front-loaded collection pattern. */
            do cashflow_index=1 to 4;
                select (cashflow_index);
                    when (1) do; lag_months=3;  cf_weight=0.34; end;
                    when (2) do; lag_months=6;  cf_weight=0.29; end;
                    when (3) do; lag_months=12; cf_weight=0.22; end;
                    otherwise do; lag_months=18; cf_weight=0.15; end;
                end;

                gross_recovery=ultimate_gross*cf_weight;
                recovery_cost=0.20*gross_recovery + 8;
                net_recovery=max(0,gross_recovery-recovery_cost);
                cashflow_date=intnx('month',default_date,lag_months,'e');
                recovery_channel='Unsecured collections';
                output;
            end;
        end;
        else do;
            cashflow_index=0;
            lag_months=&RECOVERY_HORIZON_M.;
            cashflow_date=intnx('month',default_date,lag_months,'e');
            gross_recovery=0;
            recovery_cost=0;
            net_recovery=0;
            recovery_channel='No recovery';
            output;
        end;
    end;

    /*-------------------------------------------------------------------------
      PERSONAL LOAN: UNSECURED BUT SOMEWHAT HIGHER COLLECTION POTENTIAL
    -------------------------------------------------------------------------*/
    else if product_type='Personal Loan' then do;
        recovery_group='Unsecured';

        p_any_recovery = 0.76
                         * score_recovery_mult
                         * recovery_stress_mult
                         * exp(-0.000008*max(0,balance_at_default-10000));
        p_any_recovery=max(0.38,min(0.88,p_any_recovery));

        if rand('uniform') < p_any_recovery then do;
            gross_rec_rate = 0.07 + 0.52*rand('beta',2.7,5.2);
            gross_rec_rate = gross_rec_rate
                             * score_recovery_mult
                             * recovery_stress_mult;
            gross_rec_rate=max(0.03,min(0.58,gross_rec_rate));

            ultimate_gross=min(balance_at_default,
                               balance_at_default*gross_rec_rate);

            do cashflow_index=1 to 4;
                select (cashflow_index);
                    when (1) do; lag_months=3;  cf_weight=0.30; end;
                    when (2) do; lag_months=6;  cf_weight=0.30; end;
                    when (3) do; lag_months=12; cf_weight=0.25; end;
                    otherwise do; lag_months=18; cf_weight=0.15; end;
                end;

                gross_recovery=ultimate_gross*cf_weight;
                recovery_cost=0.17*gross_recovery + 10;
                net_recovery=max(0,gross_recovery-recovery_cost);
                cashflow_date=intnx('month',default_date,lag_months,'e');
                recovery_channel='Settlement / collections';
                output;
            end;
        end;
        else do;
            cashflow_index=0;
            lag_months=&RECOVERY_HORIZON_M.;
            cashflow_date=intnx('month',default_date,lag_months,'e');
            gross_recovery=0;
            recovery_cost=0;
            net_recovery=0;
            recovery_channel='No recovery';
            output;
        end;
    end;

    available_by_cutoff=(cashflow_date<=&SNAP_END.);

    keep
        account_id customer_id product_type vehicle_type
        default_date balance_at_default collateral_value_at_default
        score_at_default effective_interest_rate
        unemployment_rate fed_funds_rate real_gdp_growth
        recovery_group recovery_channel cashflow_index
        lag_months cashflow_date
        gross_recovery recovery_cost net_recovery
        available_by_cutoff;
run;

/*=============================================================================
  3. AGGREGATE CASH FLOWS AND DERIVE REALIZED LGD
=============================================================================*/

proc sql;
    create table work.recovery_agg as
    select
        account_id,
        sum(gross_recovery) as total_gross_recovery,
        sum(recovery_cost) as total_recovery_cost,
        sum(net_recovery) as total_net_recovery,

        sum(
            net_recovery /
            ((1 + effective_interest_rate/12)**lag_months)
        ) as pv_net_recovery_full,

        sum(
            case when available_by_cutoff=1 then
                net_recovery /
                ((1 + effective_interest_rate/12)**lag_months)
            else 0 end
        ) as pv_net_recovery_asof,

        sum(net_recovery>0) as n_positive_cashflows,
        max(case when net_recovery>0 then lag_months else . end)
            as last_recovery_month
    from INT.recovery_cashflows
    group by account_id;
quit;

proc sql;
    create table MODEL.lgd_abt as
    select
        d.*,
        r.total_gross_recovery,
        r.total_recovery_cost,
        r.total_net_recovery,
        r.pv_net_recovery_full,
        r.pv_net_recovery_asof,
        r.n_positive_cashflows,
        r.last_recovery_month,

        case when d.balance_at_default>0 then
            r.total_gross_recovery/d.balance_at_default
        else . end as gross_recovery_rate,

        case when d.balance_at_default>0 then
            r.total_net_recovery/d.balance_at_default
        else . end as net_recovery_rate,

        case when d.balance_at_default>0 then
            max(0,min(1,
                (d.balance_at_default-r.pv_net_recovery_full)
                / d.balance_at_default
            ))
        else . end as realized_lgd_full,

        case when d.balance_at_default>0 then
            max(0,min(1,
                (d.balance_at_default-r.pv_net_recovery_asof)
                / d.balance_at_default
            ))
        else . end as observed_lgd_asof,

        (d.default_date <= &LGD_MATURE_CUTOFF.)
            as recovery_mature_flag

    from INT.default_enriched as d
    left join work.recovery_agg as r
        on d.account_id=r.account_id
    order by d.account_id;
quit;

/* Model-development subset: only defaults with full 18-month observation
   window available by SNAP_END. */
data MODEL.lgd_abt_mature;
    set MODEL.lgd_abt;
    if recovery_mature_flag=1;
run;

/*=============================================================================
  4. BUILD PRE-DEFAULT EAD / CCF TARGETS

  We create 12-, 6-, and 3-month observation horizons.  Credit-card CCF is
  derived from the actual simulated balance path:

      CCF = (EAD_default - Drawn_observation) / Undrawn_observation

  We preserve the RAW realized CCF and separately flag unstable/outlier cases.
  No silent clipping is applied here.
=============================================================================*/

data work.ead_horizons;
    input horizon_months;
    datalines;
12
6
3
;
run;

proc sql;
    create table INT.ead_target_candidates as
    select
        d.account_id,
        d.customer_id,
        d.product_type,
        d.default_date,
        d.balance_at_default as ead_at_default,
        d.credit_limit_at_default,
        d.score_at_default,
        d.unemployment_rate as unemp_at_default,
        d.fed_funds_rate as rate_at_default,
        d.real_gdp_growth as gdp_at_default,
        h.horizon_months,
        intnx('month',d.default_date,-h.horizon_months,'e')
            as observation_date format=date9.
    from INT.default_enriched as d,
         work.ead_horizons as h
    order by d.account_id, h.horizon_months desc;
quit;

proc sql;
    create table MODEL.ead_abt as
    select
        c.*,
        s.current_balance as drawn_at_obs,
        s.credit_limit as credit_limit_at_obs,
        s.available_limit as undrawn_at_obs,
        s.current_utilization as utilization_at_obs,
        s.current_score as score_at_obs,
        s.current_score_tier as score_tier_at_obs,
        s.dpd as dpd_at_obs,
        s.debt_to_income,
        s.employment_status_current,
        s.unemployment_rate as unemp_at_obs,
        s.fed_funds_rate as rate_at_obs,
        s.real_gdp_growth as gdp_at_obs,
        s.months_on_book,

        (not missing(s.current_balance)) as has_history,

        case
            when c.product_type='Credit Card'
             and s.available_limit>0
            then (c.ead_at_default-s.current_balance)/s.available_limit
            else .
        end as realized_ccf_raw,

        case
            when c.product_type='Credit Card'
             and s.available_limit>=500
             and not missing(s.current_balance)
            then 1 else 0
        end as ccf_eligible,

        case
            when c.product_type='Credit Card'
             and s.available_limit>0
             and (
                 (c.ead_at_default-s.current_balance)/s.available_limit < 0
                 or
                 (c.ead_at_default-s.current_balance)/s.available_limit > 1.25
             )
            then 1 else 0
        end as ccf_outlier_flag,

        case
            when s.current_balance>0
            then c.ead_at_default/s.current_balance
            else .
        end as ead_ratio_realized,

        c.ead_at_default-s.current_balance as balance_change_to_default

    from INT.ead_target_candidates as c
    left join MODEL.monthly_snapshot as s
        on c.account_id=s.account_id
       and c.observation_date=s.report_date
    order by c.account_id, c.horizon_months desc;
quit;

/*=============================================================================
  5. HARD DATA-QUALITY CHECKS
=============================================================================*/

/* Recovery cash flows cannot be negative. */
data _null_;
    set INT.recovery_cashflows end=eof;
    retain n_bad 0;

    if gross_recovery<0 then n_bad+1;
    if recovery_cost<0 then n_bad+1;
    if net_recovery<0 then n_bad+1;
    if cashflow_date<default_date then n_bad+1;
    if lag_months<0 or lag_months>&RECOVERY_HORIZON_M. then n_bad+1;

    if eof then do;
        put 'NOTE: Phase 1.3 recovery-cash-flow DQ violations = ' n_bad;
        if n_bad>0 then do;
            put 'ERROR: Phase 1.3 recovery cash-flow DQ failed.';
            abort cancel;
        end;
    end;
run;

/* LGD must be bounded and every default must appear once. */
proc sql noprint;
    select count(*) into :N_LGD trimmed from MODEL.lgd_abt;
    select count(*) into :N_BAD_LGD trimmed
    from MODEL.lgd_abt
    where missing(realized_lgd_full)
       or realized_lgd_full<0
       or realized_lgd_full>1;
quit;

%if &N_LGD. ne &N_DEFAULTS. %then %do;
    %put ERROR: LGD_ABT row count (&N_LGD.) does not match defaults (&N_DEFAULTS.).;
    %abort cancel;
%end;

%if &N_BAD_LGD. > 0 %then %do;
    %put ERROR: LGD_ABT contains &N_BAD_LGD invalid realized LGD values.;
    %abort cancel;
%end;

/* Duplicate EAD account x horizon rows are not allowed. */
proc sql noprint;
    select count(*) into :N_EAD_DUPS trimmed
    from (
        select account_id, horizon_months, count(*) as n
        from MODEL.ead_abt
        group by account_id, horizon_months
        having calculated n>1
    );
quit;

%if &N_EAD_DUPS. > 0 %then %do;
    %put ERROR: EAD_ABT contains &N_EAD_DUPS duplicate account-horizon keys.;
    %abort cancel;
%end;

/*=============================================================================
  6. CALIBRATION / REALISM OUTPUTS
=============================================================================*/

proc sql;
    create table OUT.phase13_recovery_summary as
    select
        product_type,
        count(*) as defaults,
        mean(balance_at_default) as avg_ead format=dollar14.,
        mean(gross_recovery_rate) as avg_gross_rec_rate format=percent8.2,
        mean(net_recovery_rate) as avg_net_rec_rate format=percent8.2,
        mean(realized_lgd_full) as avg_realized_lgd format=percent8.2,
        median(realized_lgd_full) as med_realized_lgd format=percent8.2,
        mean(total_recovery_cost) as avg_recovery_cost format=dollar12.,
        mean(last_recovery_month) as avg_last_rec_month format=8.2,
        mean(recovery_mature_flag) as pct_mature format=percent8.2
    from MODEL.lgd_abt
    group by product_type;
quit;

proc sql;
    create table OUT.phase13_ead_coverage as
    select
        product_type,
        horizon_months,
        count(*) as target_rows,
        sum(has_history) as rows_with_history,
        mean(has_history) as history_coverage format=percent8.2,
        sum(ccf_eligible) as ccf_eligible_rows,
        sum(ccf_outlier_flag) as ccf_outlier_rows
    from MODEL.ead_abt
    group by product_type, horizon_months
    order by product_type, horizon_months desc;
quit;

ods noproctitle;

title "Phase 1.3 Recovery / LGD Summary";
proc print data=OUT.phase13_recovery_summary noobs;
run;

title "Realized LGD Distribution by Product";
proc means data=MODEL.lgd_abt n mean std p10 p25 p50 p75 p90;
    class product_type;
    var realized_lgd_full gross_recovery_rate net_recovery_rate;
run;

title "Recovery Maturity at Project Cutoff";
proc freq data=MODEL.lgd_abt;
    tables product_type*recovery_mature_flag / nocol norow nopercent;
run;

title "Sample Recovery Cash Flows";
proc print data=INT.recovery_cashflows(obs=40) noobs;
    var account_id product_type default_date recovery_channel
        cashflow_date lag_months gross_recovery recovery_cost net_recovery
        available_by_cutoff;
run;

title "Phase 1.3 EAD Target Coverage";
proc print data=OUT.phase13_ead_coverage noobs;
run;

title "Credit Card Realized CCF by Horizon — Eligible Rows";
proc means data=MODEL.ead_abt n mean std p10 p25 p50 p75 p90;
    class horizon_months;
    where product_type='Credit Card' and ccf_eligible=1;
    var realized_ccf_raw balance_change_to_default utilization_at_obs;
run;

title "Term-Loan EAD Ratio by Product and Horizon";
proc means data=MODEL.ead_abt n mean std p10 p25 p50 p75 p90;
    class product_type horizon_months;
    where product_type in ('Auto Loan','Personal Loan') and has_history=1;
    var ead_ratio_realized balance_change_to_default;
run;

title "LGD Development Sample Size — Mature Defaults Only";
proc freq data=MODEL.lgd_abt_mature;
    tables product_type / missing;
run;

title;
ods proctitle;

/*=============================================================================
  PHASE 1.3 CHECKPOINT
  --------------------
  DO NOT proceed to LGD/EAD model fitting until the outputs above are reviewed.

  Expected qualitative ordering (project calibration, not regulatory rule):
      Auto Loan      -> lowest LGD due to collateral
      Personal Loan  -> higher LGD (unsecured)
      Credit Card    -> highest / near-highest LGD (unsecured)

  For EAD:
      Credit-card realized CCF should generally increase as the observation
      horizon approaches default, while substantial heterogeneity remains.
=============================================================================*/
