/*==============================================================================
   18. CREATE TRAIN-BASED PD BINS
==============================================================================*/

/*
   PSI compares the TRAIN distribution with VALID distribution.

               VALID_i - TRAIN_i
   PSI = SUM ---------------------- conceptually weighted by log ratio

   Exact implementation:

   PSI_i =
       (VALID_i - TRAIN_i)
       × ln(VALID_i / TRAIN_i)
*/


proc rank
    data=work.scored(
        where=(role='TRAIN')
    )
    groups=10
    out=work.train_bins;

    var pred_pd;

    ranks bin;

run;


/*==============================================================================
   19. TRAIN BIN CUT-OFFS
==============================================================================*/

proc sql;

    create table work.bincuts as

    select

        bin,

        min(pred_pd)
            as cut_low,

        max(pred_pd)
            as cut_high

    from work.train_bins

    group by bin

    order by bin;

quit;


/*==============================================================================
   20. APPLY TRAIN BINS TO TRAIN + VALID
==============================================================================*/

/*
   This preserves the course implementation:
   assign observations when predicted PD falls between
   the TRAIN minimum and maximum for a bin.
*/


proc sql;

    create table work.scored_binned as

    select

        a.*,
        b.bin

    from work.scored as a

    left join work.bincuts as b

        on
        a.pred_pd
        between
        b.cut_low
        and
        b.cut_high;

quit;


