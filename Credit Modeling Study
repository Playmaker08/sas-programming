  19. SPLIT BASELINE / LATEST
==============================================================================*/

data
    work.__base_raw
    work.__latest_raw;

    set &ds;


    if &cohort_var=&_base_val
    then
        output work.__base_raw;


    if &cohort_var=&_latest_val
    then
        output work.__latest_raw;

run;


/*==============================================================================
  20. CREATE PSI SCORE
==============================================================================*/

data work.__base;

    set work.__base_raw;

    score_used =
        &score_var;

run;


data work.__latest;

    set work.__latest_raw;


    /*
      Deliberately forced drift from course source.
    */

    score_used =
        &mult*&score_var
        +
        &add;

run;


/*==============================================================================
  21. BASELINE DECILE CUT-POINTS
==============================================================================*/

proc univariate
    data=work.__base
    noprint;

    var score_used;


    output
        out=work._ptiles

        pctlpts=
            10
            20
            30
            40
            50
            60
            70
            80
            90

        pctlpre=P;

run;


/*------------------------------------------------------------------------------
  Save percentile values as macro variables
------------------------------------------------------------------------------*/

data _null_;

    set work._ptiles;


    array p[9]

        P10
        P20
        P30
        P40
        P50
        P60
        P70
        P80
        P90;


    do i=1 to 9;

        call symputx(
            vname(p[i]),
            p[i]
        );

    end;

run;


/*==============================================================================
  22. BINNING MACRO
==============================================================================*/

%macro _bin(in=,out=);


    data &out;

        set &in;


        length bin 8;


        if missing(score_used)
        then
            bin=.;


        else if score_used<&P10
        then bin=0;


        else if score_used<&P20
        then bin=1;


        else if score_used<&P30
        then bin=2;


        else if score_used<&P40
        then bin=3;


        else if score_used<&P50
        then bin=4;


        else if score_used<&P60
        then bin=5;


        else if score_used<&P70
        then bin=6;


        else if score_used<&P80
        then bin=7;


        else if score_used<&P90
        then bin=8;


        else
            bin=9;

    run;


%mend;


%_bin(
    in=work.__base,
    out=work.base_binned
);


%_bin(
    in=work.__latest,
    out=work.latest_binned
);


/*==============================================================================
  23. PSI DISTRIBUTIONS
==============================================================================*/

proc sql;


    create table work.base_dist as

    select

        bin,

        count(*)
            as n_b

    from work.base_binned

    where
        bin is not null

    group by
        bin;


    create table work.latest_dist as

    select

        bin,

        count(*)
            as n_l

    from work.latest_binned

    where
        bin is not null

    group by
        bin;


quit;


/*------------------------------------------------------------------------------
  Totals
------------------------------------------------------------------------------*/

proc sql noprint;


    select
        sum(n_b)

    into
        :tot_b

    from work.base_dist;


    select
        sum(n_l)

    into
        :tot_l

    from work.latest_dist;


quit;


/*==============================================================================
  24. MERGE BASELINE / LATEST DISTRIBUTIONS
==============================================================================*/

proc sql;

    create table work.psi_prep as

    select

        coalesce(
            b.bin,
            l.bin
        )
            as bin,

        coalesce(
            b.n_b,
            0
        )
            as n_b,

        coalesce(
            l.n_l,
            0
        )
            as n_l

    from work.base_dist as b

    full join
        work.latest_dist as l

    on
        b.bin=l.bin

    order by
        bin;

quit;


/*==============================================================================
  25. PSI CALCULATION
==============================================================================*/

/*

                    p_latest,b
      PSI_b =
        (p_latest,b - p_base,b)
        ×
        ln -----------------
                    p_base,b


      PSI =
        SUM_b PSI_b


  epsilon smoothing prevents ln(0).
*/


data work.psi_calc;

    set work.psi_prep;


    length
        p_b
        p_l
        term
        8;


    p_b =

        (n_b + &eps)

        /

        (&tot_b + 10*&eps);


    p_l =

        (n_l + &eps)

        /

        (&tot_l + 10*&eps);


    term =

        (p_l-p_b)

        *

        log(
            p_l/p_b
        );


    format

        p_b
        p_l
        percent8.2

        term
        8.6;

run;


/*==============================================================================
  26. TOTAL PSI
==============================================================================*/

proc sql;

    create table work.psi_summary as

    select

        sum(term)
            as PSI
            format=8.6

    from work.psi_calc;

quit;


