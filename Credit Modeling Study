    set work.bin_pivot;


    /*
       Avoid log(0)
    */

    train =
        coalesce(
            pct_TRAIN,
            0.0001
        )/100;


    valid =
        coalesce(
            pct_VALID,
            0.0001
        )/100;


    psi_bin =

        (
            valid-train
        )

        *

        log(
            valid/train
        );

run;


