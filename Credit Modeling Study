quit;


/*==============================================================================
===============================================================================
                    METHOD 6
            SIMPLE LINEAR REGRESSION
===============================================================================
==============================================================================*/


/*
   Benchmark:

   LGD =
       beta0
       + beta1 LTV
       + beta2 Interest Rate
       + beta3 DPD
       + beta4 Guarantee
       + error

   Predictions may fall outside [0,1].
*/


proc reg
    data=work.lgd_train
    outest=work.linear_estimates;


    model LGD_OBS =

        LTV
        INTEREST_RATE
        DAYS_PAST_DUE
        GUARANTEE_FLAG;


    output
        out=work.linear_train_pred
        p=LGD_PRED;

quit;


/*---------------------------------------------------------------------------
   SOURCE IMPLEMENTATION

   Original course code refits PROC REG on TEST.
   Therefore the following is preserved for learning,
   but is NOT strict holdout validation.
---------------------------------------------------------------------------*/

proc reg
    data=work.lgd_test;


    model LGD_OBS =

        LTV
        INTEREST_RATE
        DAYS_PAST_DUE
        GUARANTEE_FLAG;


    output
        out=work.score_linear
        p=LGD_PRED;

quit;


/* Clip predictions */

data work.score_linear;

    set work.score_linear;


    if LGD_PRED<0
    then
        LGD_PRED=0;


    else if LGD_PRED>1
    then
        LGD_PRED=1;


    length Model $30;

    Model =
        "Simple Linear Regression";

run;


