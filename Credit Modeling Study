            )
        )
            as RMSE

    from work.score_fractional;

quit;


/*==============================================================================
===============================================================================
                    METHOD 8
               BETA MIXED EFFECTS
===============================================================================
==============================================================================*/


/*
   Conditional model:

   logit(mu_ij)
      =
   X_ij beta + u_j

   Random intercept:

       u_j ~ N(0,sigma_u^2)

   Source grouping:
       REGION
*/


proc glimmix
    data=work.lgd_train
    method=quad(qpoints=25);


    class

        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT;


