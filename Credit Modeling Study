                count(*) as n_loans,

                sum(status) as n_events


            from work.cohort_survival


            group by
                cohort_y;


        quit;


        proc sort
            data=work.cohort_survival;

            by cohort_y;

        run;


        proc sort
            data=work.year_stats;

            by cohort_y;

        run;


