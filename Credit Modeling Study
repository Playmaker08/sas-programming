==============================================================================*/

data work.pd_dq;

    set work.pd_data;


    /*----------------------------------------------------------------------
      Remove observations already defaulted by reporting date
    ----------------------------------------------------------------------*/

    if not missing(default_date)
       and default_date <= report_date
    then
        delete;


    /*----------------------------------------------------------------------
      DPD cannot be negative
    ----------------------------------------------------------------------*/

    dpd =
        max(
            0,
            dpd
        );


    /*----------------------------------------------------------------------
      Re-enforce utilization bounds
    ----------------------------------------------------------------------*/

    credit_utilization =

        max(
            0,
            min(
                credit_utilization,
                1
            )
        );


    /*----------------------------------------------------------------------
      CREATE FORWARD-LOOKING 12-MONTH DEFAULT TARGET

      target_12m = 1
          if borrower defaults within next 12 months

      target_12m = 0
          otherwise
    ----------------------------------------------------------------------*/

    length target_12m 8;


    target_12m=0;


    if not missing(default_date)
    then do;


        if intck(
            'month',
            report_date,
            default_date,
            'c'
        ) <= 12

        then
            target_12m=1;


    end;

run;


