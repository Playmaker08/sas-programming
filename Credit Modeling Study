==============================================================================*/

/*
   Instead of deleting missing categories:

       employment_status = missing

   create:

       employment_status_lvl = "Missing"

   This allows missingness itself to carry information.
*/


%macro add_missing_level(
    in=work.demo_missing,
    out=work.missing_level,
    catvars=&cat_vars
);

    data &out.;
        set &in.;

        %local i v;

        %let i=1;

        %do %while(%scan(&catvars.,&i.) ne );

            %let v=%scan(&catvars.,&i.);

            length &v._lvl $40;

            &v._lvl =
                coalescec(
                    strip(&v.),
                    "Missing"
                );

            %let i=%eval(&i.+1);

        %end;

    run;

%mend;


%add_missing_level();


