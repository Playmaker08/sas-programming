            )
        )
            as RMSE

    from work.score_beta_mixed;

quit;


/*==============================================================================
===============================================================================
                    METHOD 9
             ZERO-ONE INFLATED BETA
===============================================================================
==============================================================================*/


/*
   Three components:

                  P0
              LGD = 0
                 │
                 │
       ┌─────────┴─────────┐
       │                   │
       ▼                   ▼
   MID component         LGD = 1
   0 < LGD < 1             P1
       │
       ▼
   Beta Regression


   Expected LGD:

   E(LGD|X)
       =
   0*P0 + mu_beta*Pmid + 1*P1

       =
   P1 + Pmid*mu_beta
*/


/*---------------------------------------------------------------------------
   ZOIB requires STRATIFIED split because boundary classes
   may be relatively uncommon.
---------------------------------------------------------------------------*/

proc sort
    data=work.lgd_prep
    out=work.zoib_prep;

    by LGD_CLASS;

run;


proc surveyselect
    data=work.zoib_prep
    out=work.zoib_split
    seed=&seed.
    samprate=0.70
    outall
    method=srs;


    strata
        LGD_CLASS;

run;


data
    work.zoib_train
    work.zoib_test;

    set work.zoib_split;


    if selected=1
    then
        output work.zoib_train;

    else
        output work.zoib_test;

run;


/*---------------------------------------------------------------------------
   PART A — Multinomial boundary model
---------------------------------------------------------------------------*/

proc logistic
    data=work.zoib_train
    outmodel=work.mn_model;


    class

        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT

        /
        param=glm;


    model LGD_CLASS(
        ref="MID"
    ) =

        LTV
        INTEREST_RATE
        DAYS_PAST_DUE
        GUARANTEE_FLAG
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT

        /
        link=glogit;

run;


/* Frozen multinomial model -> TEST */

proc logistic
    inmodel=work.mn_model;


    score
        data=work.zoib_test
        out=work.mn_score;

run;


/* Standardize probabilities */

data work.mn_score;

    set work.mn_score;


    if missing(P_MID)
    then

        P_MID =

            1
            -
            coalesce(P_ZERO,0)
            -
            coalesce(P_ONE,0);

run;


/*---------------------------------------------------------------------------
   PART B — Beta model for 0 < LGD < 1
---------------------------------------------------------------------------*/

proc glimmix
    data=work.zoib_train(
        where=(ismid=1)
    )
    method=quad(qpoints=25);


    class

        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT;


    model LGD_beta =

        LTV
        INTEREST_RATE
        DAYS_PAST_DUE
        GUARANTEE_FLAG
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT

        /

        dist=beta
        link=logit
        solution;


    random
        intercept
        /
        subject=REGION;


    store
        out=work.zoib_beta_store;

run;


/* Score full TEST sample */

proc plm
    restore=work.zoib_beta_store;


    score
        data=work.mn_score
        out=work.score_zoib
        /
        ilink;

quit;


/*---------------------------------------------------------------------------
   Combine components
---------------------------------------------------------------------------*/

data work.score_zoib;

    set work.score_zoib;


    /*
       Predicted = conditional Beta mean
    */


    LGD_PRED =

        coalesce(P_ONE,0)

        +

        coalesce(Predicted,0)
        *
        coalesce(P_MID,0);


    length Model $30;

    Model =
        "ZOIB Multinomial + Beta";

run;


