/*==============================================================================
   7. HOT-DECK IMPUTATION
==============================================================================*/

/*
   HOT-DECK LOGIC

   Borrower with missing X receives X from a similar donor.

   Matching variables:

       employment_status
       marital_status
       region
       stage

   Target:

       credit_utilization

   Corrected master script uses PROC SURVEYIMPUTE.
*/


%macro hotdeck_fast(

    in=work.demo_missing,

    out=work.hotdeck_imp,

    id=account_id,

    classvars=
        employment_status
        marital_status
        region
        stage,

    targetvars=
        credit_utilization,

    merge_back=Y
);


    /*-------------------------------------------------------------
      Create RAW copies of target variables
    -------------------------------------------------------------*/

    %local
        i
        v
        targ_raw_list;


    %let i=1;

    %let targ_raw_list=;


    %do %while(%scan(&targetvars.,&i.) ne );

        %let v=%scan(&targetvars.,&i.);

        %let targ_raw_list =
            &targ_raw_list.
            &v._raw;

        %let i=%eval(&i.+1);

    %end;


    /*-------------------------------------------------------------
      Prepare slim hot-deck dataset
    -------------------------------------------------------------*/

    data _hd_prep
        (
            keep=
                &id.
                &classvars.
                &targetvars.
                &targ_raw_list.
        );

        set &in.
            (
                keep=
                    &id.
                    &classvars.
                    &targetvars.
            );


        array t {*} &targetvars.;

        array r {*} &targ_raw_list.;


        do _k=1 to dim(t);

            r[_k]=t[_k];

        end;


        drop _k;

    run;


    /*-------------------------------------------------------------
      Hot-deck imputation
    -------------------------------------------------------------*/

    proc surveyimpute
        data=_hd_prep
        method=hotdeck
        ndonors=1
        order=data
        seed=42
        noprint;

        class &classvars.;

        var &targetvars.;

        output out=_hd_imp;

    run;


    /*-------------------------------------------------------------
      Create:
          *_imp
          *_impflag
    -------------------------------------------------------------*/

    data _hd_imp2;

        set _hd_imp;


        %let i=1;


        %do %while(%scan(&targetvars.,&i.) ne );

            %let v=%scan(&targetvars.,&i.);


            &v._imp =
                &v.;


            &v._impflag =
                missing(&v._raw);


            %let i=%eval(&i.+1);

        %end;

    run;


    /*-------------------------------------------------------------
      Return slim dataset OR merge to original dataset
    -------------------------------------------------------------*/

    %if %upcase(&merge_back.)=N
    %then %do;


        data &out.;

            set _hd_imp2;

        run;


    %end;


    %else %do;


        /*---------------------------------------------------------
          Hash merge avoids sorting full portfolio
        ---------------------------------------------------------*/

        data &out.;


            if 0
            then
                set _hd_imp2;


            declare hash H
                (
                    dataset:"_hd_imp2"
                );


            H.defineKey("&id.");


            H.defineData(
                all:'Y'
            );


            H.defineDone();


            do until(eof);


                set &in.
                    end=eof;


                rc =
                    H.find();


                drop rc;


                output;


            end;

        run;


    %end;


    /* Cleanup */

    proc datasets
        lib=work
        nolist;

        delete
            _hd_prep
            _hd_imp
            _hd_imp2;

    quit;


%mend;


/* Run hot-deck */

%hotdeck_fast(

    in=work.demo_missing,

    out=work.hotdeck_imp,

    id=account_id,

    classvars=
        employment_status
        marital_status
        region
        stage,

    targetvars=
        credit_utilization,

    merge_back=Y

);


/* QA */

proc means
    data=work.hotdeck_imp
    n
    nmiss
    mean;

    var
        credit_utilization_raw
        credit_utilization_imp;

    title "QA - Hot-Deck Imputation";

run;


title;


/*==============================================================================
   8. REGRESSION IMPUTATION
==============================================================================*/

/*
   Example:

       AGE is missing.

   Estimate:

       AGE =
          b0
        + b1 INTERNAL_SCORE
        + b2 CREDIT_UTILIZATION
        + b3 GDP_GROWTH
        + b4 UNEMPLOYMENT
        + b5 INTEREST_RATE
        + error

   Then:

       AGE_IMP =
           AGE                 if observed
           Predicted AGE       if missing
*/


%macro impute_regression(

    in=work.demo_missing,

    out=work.reg_imp,

    target=age,

    predictors=
        internal_score
        credit_utilization
        macro_gdp_growth
        macro_unemployment
        macro_interest_rate

);


    /*-------------------------------------------------------------
      Split observations
    -------------------------------------------------------------*/

    data
        _train
        _apply;

        set &in.;


        if not missing(&target.)
        then
            output _train;

        else
            output _apply;

    run;


    /*-------------------------------------------------------------
      Select regression model
    -------------------------------------------------------------*/

    proc glmselect
        data=_train
        seed=42
        plots=none;


        partition
            fraction(validate=0.20);


        model &target. =
            &predictors.

            /
            selection=
                stepwise
                (
                    select=aic
                    choose=validate
                    stop=none
                );


        output
            out=_pred_train
            p=&target._pred;

    run;

    quit;


    /*-------------------------------------------------------------
      Fit model and score missing cases
    -------------------------------------------------------------*/

    proc glmselect
        data=_train
        plots=none;


        model &target. =
            &predictors.;


        score
            data=_apply
            out=_pred_apply
            p=&target._pred;

    run;

    quit;


    /*-------------------------------------------------------------
      Combine
    -------------------------------------------------------------*/

    data &out.;

        set
            _pred_train
            _pred_apply;


        &target._imp =
            coalesce(
                &target.,
                &target._pred
            );


        drop
            &target._pred;

    run;


    /* Cleanup */

    proc datasets
        lib=work
        nolist;

        delete
            _train
            _apply
            _pred_train
            _pred_apply;

    quit;


%mend;


