      Rule/unit-test concepts

  It does NOT calculate monetary ECL because the supplied batch does not
  contain LGD, EAD, discount factors, or lifetime marginal PD schedules.
==============================================================================*/


/*==============================================================================
  0. SETUP
==============================================================================*/

options
    nodate
    nonumber
    nocenter
    msglevel=i
    validvarname=any
    mlogic
    mprint
    symbolgen;

ods graphics on;


/*------------------------------------------------------------------------------
  Input file
------------------------------------------------------------------------------*/

%let data_path =
/home/u49308301/UDEMY_LESSONS/Lession1/Module6/ifrs9_pit_pd_lite.csv;


/*------------------------------------------------------------------------------
  Check that input exists
------------------------------------------------------------------------------*/

filename _chk "&data_path.";


%macro _assert_csv();

    %if %sysfunc(fexist(_chk)) %then %do;

        %put NOTE: >>> Setup complete.;
        %put NOTE: >>> CSV found at &data_path.;

    %end;

    %else %do;

        %put ERROR: >>> CSV NOT FOUND at &data_path.;
        %put ERROR: >>> Check folder, spelling and case.;
        %put ERROR: >>> Verify the path in SAS Studio.;

    %end;

%mend;


%_assert_csv();

filename _chk clear;


/*==============================================================================
  1. IMPORT DATA
==============================================================================*/

proc import
    datafile="&data_path."
    out=work.raw
    dbms=csv
    replace;

    guessingrows=max;
    getnames=yes;

run;


/*==============================================================================
  2. BASIC DATA PREPARATION
==============================================================================*/

data work.raw;

    set work.raw;


    /*----------------------------------------------------------------------
      Standardise report_date
    ----------------------------------------------------------------------*/

    if vtype(report_date)='C'
    then
        report_date_num =
            input(report_date,anydtdte.);

    else
        report_date_num =
            report_date;


    format report_date_num yymmdd10.;


    drop report_date;

    rename
        report_date_num=report_date;


    /*----------------------------------------------------------------------
      Ensure PIT PD is represented as proportion 0–1
    ----------------------------------------------------------------------*/

    if not missing(pit_pd_12m)
       and pit_pd_12m>1
    then
        pit_pd_12m =
            pit_pd_12m/100;

run;


/*==============================================================================
  3. DERIVE ORIGINATION PD PROXY
==============================================================================*/

/*
  Course proxy:

      pd12m_orig =
          first observed PIT PD
          for each account.

  IMPORTANT:
      This is an origination-PD proxy, not necessarily true origination PD.
*/


proc sort
    data=work.raw;

    by
        account_id
        report_date;

run;


data work.with_orig_pd;

    set work.raw;

    by
        account_id
        report_date;


    retain pd12m_orig;


    if first.account_id
    then
        pd12m_orig =
            pit_pd_12m;

run;


/*------------------------------------------------------------------------------
  Import QC
------------------------------------------------------------------------------*/

title "Initial Data QC";


proc means
    data=work.with_orig_pd
    n
    nmiss
    mean
    min
    p25
    p50
    p75
    max;

    var
        pit_pd_12m
        pd12m_orig
        dpd;

run;


