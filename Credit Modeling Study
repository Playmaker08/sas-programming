/*==============================================================================
   10. COMPUTE POINT + CUMULATIVE LIFT/GAINS
==============================================================================*/

data work.lift_gains;

    merge
        work.lg_dec_sums(in=a)
        work.lg_role_totals(in=b);

    by role;

    if a;


    pop =
        bad+good;


    total_pop =
        total_bad+total_good;


    overall_rt =
        total_bad/total_pop;


    /*
       Original rank:
       0 = lowest PD
       9 = highest PD

       Flip ordering:
       0 = highest-risk bin
    */

    decile_desc =
        9-decile;

run;


proc sort
    data=work.lift_gains;

    by
        role
        decile_desc;

run;


data work.lift_gains;

    set work.lift_gains;

    by
        role
        decile_desc;


    retain
        cum_resp
        cum_pop;


    if first.role
    then do;

        cum_resp=0;
        cum_pop=0;

    end;


    cum_resp + bad;
    cum_pop + pop;


    /* Point event rate */

    resp_rate =
        bad/pop;


    /* Point lift */

    lift =
        resp_rate/overall_rt;


    /* Cumulative population */

    cum_pct_pop =
        cum_pop/total_pop;


    /* Cumulative default capture */

    gains =
        cum_resp/total_bad;


    /* Cumulative lift */

    cum_lift =
        gains/cum_pct_pop;


    keep

        role
        decile
        decile_desc

        pop
        bad
        good

        overall_rt
        resp_rate
        lift

        cum_pop
        cum_resp
        cum_pct_pop
        gains
        cum_lift;

run;


