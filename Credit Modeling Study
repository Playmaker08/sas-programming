        LTV
        INTEREST_RATE
        DAYS_PAST_DUE
        GUARANTEE_FLAG
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        ECONOMIC_SEGMENT

        /

        dist=beta
        link=logit
        solution;


    random
        intercept
        /
        subject=REGION;


    store
        out=work.beta_mix_store;

run;


/* Score TEST */

proc plm
    restore=work.beta_mix_store;


    score
        data=work.lgd_test
        out=work.score_beta_mixed
        /
        ilink;

quit;


/* Standardize prediction */

data work.score_beta_mixed;

    set work.score_beta_mixed;


    LGD_PRED =
        Predicted;


    length Model $30;

    Model =
        "Beta Mixed Effects";

run;


/* Evaluate */

proc sql;

