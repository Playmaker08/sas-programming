/*==============================================================================
  13. TRAIN 12-MONTH PIT PD MODEL
==============================================================================*/

/*

  LOGISTIC MODEL:

                 PD
      ln ----------------
             1 - PD

          = beta0

          + beta1  score_rev
          + beta2  util_log
          + beta3  dpd_clip
          + beta4  dpd_30plus

          + beta5  age2
          + beta6  age_6m
          + beta7  age_6_24
          + beta8  age_24p

          + beta9  GDP growth
          + beta10 unemployment
          + beta11 interest rate


  PIT orientation comes partly from contemporaneous macroeconomic
  variables entering the model.
*/


proc logistic
    data=work.train_fe
    outmodel=work.pd_model
    plots(only)=roc;


    class

        dpd_30plus(
            ref='0'
        )

        age_6m(
            ref='0'
        )

        age_6_24(
            ref='0'
        )

        age_24p(
            ref='0'
        )

        /
        param=ref;


    model target_12m(
        event='1'
    ) =

        score_rev
        util_log
        dpd_clip
        dpd_30plus

        age2
        age_6m
        age_6_24
        age_24p

        macro_gdp_growth
        macro_unemployment
        macro_interest_rate

        /
        lackfit
        rsq;


    /*----------------------------------------------------------------------
      SCORE ALL THREE DATASETS USING THE TRAINED MODEL
    ----------------------------------------------------------------------*/

    score
        data=work.train_fe
        out=work.train_scored;


    score
        data=work.valid_fe
        out=work.valid_scored;


    score
        data=work.test_fe
        out=work.test_scored;


run;


