run;


/*------------------------------------------------------------------------------
   Aggregate bad/good counts
------------------------------------------------------------------------------*/

proc summary
    data=work.deciles_ks
    nway;

    class
        role
        decile;

    var
        bad
        good;

    output
        out=work.ks_dec_sums(
            drop=_:
        )
        sum=
            bad
            good;

run;


/*------------------------------------------------------------------------------
   Total bad/good per role
------------------------------------------------------------------------------*/

proc summary
    data=work.ks_dec_sums
    nway;

    class role;

    var
        bad
        good;

    output
        out=work.ks_role_totals(
            drop=_:
        )
        sum=
            total_bad
            total_good;

run;


proc sort
    data=work.ks_dec_sums;

    by role decile;

run;


proc sort
    data=work.ks_role_totals;

    by role;

run;


/*------------------------------------------------------------------------------
   Calculate cumulative distributions
------------------------------------------------------------------------------*/

data work.ks_calc;

    merge
        work.ks_dec_sums(in=a)
        work.ks_role_totals(in=b);

    by role;

    if a;


    retain
        cum_bad
        cum_good;


    if first.role
    then do;

        cum_bad=0;
        cum_good=0;

    end;


    cum_bad + bad;
    cum_good + good;


    cdf_bad =
        cum_bad/total_bad;


    cdf_good =
        cum_good/total_good;


    ks =
        abs(
            cdf_bad-cdf_good
        );

run;


/*------------------------------------------------------------------------------
   Final KS
------------------------------------------------------------------------------*/

proc sql;

    create table work.ks_summary as

    select

        role,

        max(ks)
            as KS
            format=8.4

    from work.ks_calc

    group by role;

quit;


