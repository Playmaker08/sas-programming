/*==============================================================================
   9. CLUSTER-BASED IMPUTATION
      PROC FASTCLUS
==============================================================================*/

/*
   STEP 1:
       Cluster borrowers using risk characteristics.

   STEP 2:
       Calculate cluster-level mean/median.

   STEP 3:
       Replace missing target with its cluster statistic.

   Default:

       Cluster variables:
           internal_score
           credit_utilization

       K = 5

       Target:
           internal_score

       Statistic:
           mean
*/


%macro impute_fastclus(

    in=work.demo_missing,

    out=work.fastclus_imp,

    cluster_vars=
        internal_score
        credit_utilization,

    k=5,

    target=internal_score,

    stat=mean

);


    /*-------------------------------------------------------------
      Complete rows for clustering
    -------------------------------------------------------------*/

    data _clus_prep;

        set &in.;


        if nmiss(
            of &cluster_vars.
        )=0;

    run;


    /*-------------------------------------------------------------
      K-means
    -------------------------------------------------------------*/

    proc fastclus
        data=_clus_prep
        maxc=&k.
        maxiter=100
        out=_clus_out;


        var &cluster_vars.;

    run;


    /*-------------------------------------------------------------
      Attach cluster ID back to portfolio
    -------------------------------------------------------------*/

    proc sql;


        create table _joined as


        select
            a.*,
            b.cluster


        from &in. as a


        left join
        (
            select
                &id_var.,
                cluster

            from _clus_out
        ) as b


        on
            a.&id_var.
            =
            b.&id_var.;


    quit;


    /*-------------------------------------------------------------
      Cluster statistic
    -------------------------------------------------------------*/

    proc sql;


        create table _clus_stat as


        select
            cluster,


            %if &stat.=mean
            %then %do;

                mean(&target.)
                as target_stat

            %end;


            %else %do;

                median(&target.)
                as target_stat

            %end;


        from _joined


        where
            not missing(&target.)
            and
            not missing(cluster)


        group by
            cluster;


    quit;


    /*-------------------------------------------------------------
      Impute target
    -------------------------------------------------------------*/

    proc sql;


        create table &out. as


        select
            a.*,


            coalesce(
                a.&target.,
                c.target_stat
            )
            as &target._imp


        from _joined as a


        left join
            _clus_stat as c


        on
            a.cluster
            =
            c.cluster;


    quit;


    /* Cleanup */

    proc datasets
        lib=work
        nolist;

        delete
            _clus_prep
            _clus_out
            _joined
            _clus_stat;

    quit;


%mend;


