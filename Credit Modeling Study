/*==============================================================================
   0. GLOBAL SETTINGS
==============================================================================*/

%let path =
    /home/u49308301/UDEMY_LESSONS/Lesson 2;

%let input_file =
    &path./LGD_Model_Data.csv;

%let seed = 12345;


/*==============================================================================
   1. IMPORT LGD DATA
==============================================================================*/

filename lgd_csv "&input_file.";


proc import
    datafile=lgd_csv
    out=work.lgd_raw
    dbms=csv
    replace;

    guessingrows=MAX;

run;


/* Inspect structure */

proc contents
    data=work.lgd_raw
    order=varnum;

run;


proc print
    data=work.lgd_raw(obs=10);

run;


/*==============================================================================
   2. MASTER DATA PREPARATION
==============================================================================*/

/*
   Create model-ready versions of LGD.

   LGD_OBS:
       Original observed LGD.

   LGD_clip:
       Used for logit transformation.

   LGD_beta:
       Used for Beta regression.

   y_frac:
       Fractional response target.

   LTV:
       Alias for LTV_RATIO.
*/


data work.lgd_prep;

    set work.lgd_raw;


    /*--------------------------------------------------------------
      Core predictor
    --------------------------------------------------------------*/

    LTV =
        LTV_RATIO;


    /*--------------------------------------------------------------
      Logit-OLS target
    --------------------------------------------------------------*/

    LGD_clip =
        min(
            max(LGD_OBS,0.001),
            0.999
        );


    logit_LGD =
        log(
            LGD_clip
            /
            (1-LGD_clip)
        );


    /*--------------------------------------------------------------
      Beta target
    --------------------------------------------------------------*/

    LGD_beta =
        min(
            max(LGD_OBS,0.0001),
            0.9999
        );


    /*--------------------------------------------------------------
      Fractional response target
    --------------------------------------------------------------*/

    y_frac =
        min(
            max(LGD_OBS,1e-6),
            1-1e-6
        );


    /*--------------------------------------------------------------
      Engineered variables
    --------------------------------------------------------------*/

    has_collateral =
        (
            COLLATERAL_TYPE ne "None"
        );


    int_rate =
        INTEREST_RATE;


    d_subord =
        (
            SENIORITY="Subordinated"
        );


    /*--------------------------------------------------------------
      Boundary classification for ZOIB
    --------------------------------------------------------------*/

    is0 =
        (LGD_OBS=0);


    is1 =
        (LGD_OBS=1);


    ismid =
        (
            LGD_OBS>0
            and
            LGD_OBS<1
        );


    length LGD_CLASS $4;


    if is0
    then
        LGD_CLASS="ZERO";


    else if is1
    then
        LGD_CLASS="ONE";


    else
        LGD_CLASS="MID";


run;


/*==============================================================================
   3. INITIAL LGD DATA QUALITY / EDA
==============================================================================*/

proc means
    data=work.lgd_prep
    n
    nmiss
    mean
    std
    min
    p1
    p5
    p25
    median
    p75
    p95
    p99
    max;

    var
        LGD_OBS
        LTV
        INTEREST_RATE
        DAYS_PAST_DUE;

run;


proc freq
    data=work.lgd_prep;

    tables
        LGD_CLASS
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT
        GUARANTEE_FLAG
        / missing;

run;


proc univariate
    data=work.lgd_prep;

    var LGD_OBS;

    histogram LGD_OBS;

run;


/*==============================================================================
   4. COMMON 70/30 TRAIN-TEST SPLIT
==============================================================================*/

/*
   IMPORTANT:

   We create ONE split here so models are evaluated
   on the same observations wherever technically possible.
*/


proc surveyselect
    data=work.lgd_prep
    out=work.lgd_split
    seed=&seed.
    samprate=0.70
    outall;

run;


data
    work.lgd_train
    work.lgd_test;

    set work.lgd_split;


    if selected=1
    then
        output work.lgd_train;

    else
        output work.lgd_test;

run;


/* Check split */

proc freq
    data=work.lgd_split;

    tables selected;

run;


/*==============================================================================
===============================================================================
                    METHOD 1
              OLS ON LOGIT(LGD)
===============================================================================
==============================================================================*/


/*
   Transform:

                 LGD
   logit(LGD) = ln ---------
                1 - LGD


   Model:

   logit(LGD_i) = X_i beta + error


   Back-transform:

                    1
   LGD_hat = -----------------
             1 + exp(-eta)
*/


proc glmselect
    data=work.lgd_train
    plots=all
    seed=&seed.;


    class
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT;


    /* Internal validation inside development sample */

    partition
        fraction(validate=0.30);


    model logit_LGD =

        LTV
        has_collateral
        int_rate
        DAYS_PAST_DUE
        GUARANTEE_FLAG
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT

        /

        selection=
            stepwise(
                select=SL
                stop=SL
            )

        showpvalues

        choose=validate;


    store
        out=work.ols_logit_store;

run;

quit;


/* Score unseen TEST */

proc plm
    restore=work.ols_logit_store;


    score
        data=work.lgd_test
        out=work.score_ols_logit
        pred=logit_pred;

run;


/* Back-transform */

data work.score_ols_logit;

    set work.score_ols_logit;


    LGD_PRED =
        1/
        (
            1+
            exp(-logit_pred)
        );


    length Model $30;

    Model =
        "OLS Logit Transform";

run;


/* Evaluate */

proc sql;

    create table work.metric_ols_logit as

    select

        "OLS Logit Transform"
            as Model length=30,

        mean(
            abs(
                LGD_OBS-LGD_PRED
            )
        )
            as MAE,

        sqrt(
            mean(
                (
                    LGD_OBS-LGD_PRED
                )**2
            )
        )
            as RMSE

    from work.score_ols_logit;

quit;


/*==============================================================================
===============================================================================
                    METHOD 2
                 BETA REGRESSION
===============================================================================
==============================================================================*/


/*
   LGD ~ Beta(mu,phi)

   logit(mu_i) = X_i beta

   Requirement:

       0 < LGD < 1
*/


proc glimmix
    data=work.lgd_train;


    class
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT;


    model LGD_beta =

        LTV
        INTEREST_RATE
        DAYS_PAST_DUE
        GUARANTEE_FLAG
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT

        /

        dist=beta
        link=logit
        solution;


    store
        out=work.beta_store;

run;


/* Score on response scale */

proc plm
    restore=work.beta_store;


    score
        data=work.lgd_test
        out=work.score_beta
        predicted=LGD_PRED
        /
        ilink;

run;


/* Label */

data work.score_beta;

    set work.score_beta;

    length Model $30;

    Model =
        "Beta Regression";

run;


/* Evaluation */

proc sql;

    create table work.metric_beta as

    select

        "Beta Regression"
            as Model length=30,

        mean(
            abs(
                LGD_OBS-LGD_PRED
            )
        )
            as MAE,

        sqrt(
            mean(
                (
                    LGD_OBS-LGD_PRED
                )**2
            )
        )
            as RMSE

    from work.score_beta;

quit;


/*==============================================================================
===============================================================================
                    METHOD 3
               QUANTILE REGRESSION
===============================================================================
==============================================================================*/


/*
   Median regression:

       Q_0.50(LGD | X) = X beta

   More robust to skewness / extreme observations than OLS.

   IMPORTANT SOURCE NOTE:
   The supplied course script fits the same specification
   again on TEST because direct STORE/PLM scoring with CLASS
   effects is not supported in that implementation.

   Therefore its TEST metrics are NOT a strict frozen-model
   out-of-sample validation.

   The block below preserves that source behaviour.
*/


proc quantreg
    data=work.lgd_train
    outest=work.qr_params
    ci=resampling;


    class
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT;


    model LGD_OBS =

        LTV
        INTEREST_RATE
        DAYS_PAST_DUE
        GUARANTEE_FLAG
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT

        /
        quantile=0.5;


    output
        out=work.quantile_train_pred
        p=LGD_PRED;

run;


/*---------------------------------------------------------------------------
   COURSE IMPLEMENTATION:
   refits on TEST to obtain predictions.
---------------------------------------------------------------------------*/

proc quantreg
    data=work.lgd_test
    ci=none;


    class
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT;


    model LGD_OBS =

        LTV
        INTEREST_RATE
        DAYS_PAST_DUE
        GUARANTEE_FLAG
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT

        /
        quantile=0.5;


    output
        out=work.score_quantile
        p=LGD_PRED;

run;


data work.score_quantile;

    set work.score_quantile;

    length Model $30;

    Model =
        "Quantile Regression";

run;


/* Course-style evaluation */

proc sql;

    create table work.metric_quantile as

    select

        "Quantile Regression*"
            as Model length=30,

        mean(
            abs(
                LGD_OBS-LGD_PRED
            )
        )
            as MAE,

        sqrt(
            mean(
                (
                    LGD_OBS-LGD_PRED
                )**2
            )
        )
            as RMSE

    from work.score_quantile;

quit;


/*==============================================================================
===============================================================================
                    METHOD 4
              DECISION TREE REGRESSION
===============================================================================
==============================================================================*/


/*
   Interval target -> GROW VARIANCE.

   Cost-complexity pruning reduces overfitting.
*/


proc hpsplit
    data=work.lgd_train
    seed=&seed.;


    class
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT;


    model LGD_OBS =

        LTV
        INTEREST_RATE
        DAYS_PAST_DUE
        GUARANTEE_FLAG
        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT;


    grow variance;


    prune costcomplexity;


    partition
        fraction(validate=0.30);


    code
        file="&path./lgd_tree_score.sas";

run;


/* Score TEST */

data work.score_tree;

    set work.lgd_test;


    %include
        "&path./lgd_tree_score.sas";


    LGD_PRED =
        P_LGD_OBS;


    length Model $30;

    Model =
        "Decision Tree";

run;


/* Evaluate */

proc sql;

    create table work.metric_tree as

    select

        "Decision Tree"
            as Model length=30,

        mean(
            abs(
                LGD_OBS-LGD_PRED
            )
        )
            as MAE,

        sqrt(
            mean(
                (
                    LGD_OBS-LGD_PRED
                )**2
            )
        )
            as RMSE

    from work.score_tree;

quit;


/*==============================================================================
===============================================================================
                    METHOD 5
                RANDOM FOREST
===============================================================================
==============================================================================*/


/*
   Random Forest prediction:

                   B
                  ---
             1    \
   LGD_hat = -     >  f_b(X)
             B    /
                  ---
                  b=1

   Source:
       MAXTREES = 300
       VARS_TO_TRY = 4
*/


data work.rf_all;

    set
        work.lgd_train(in=a)
        work.lgd_test(in=b);


    length ROLE $5;


    if a
    then
        ROLE="TRAIN";


    else if b
    then
        ROLE="TEST";

run;


proc hpforest
    data=work.rf_all
    seed=&seed.
    maxtrees=300
    vars_to_try=4;


    target
        LGD_OBS
        /
        level=interval;


    input

        LTV
        INTEREST_RATE
        DAYS_PAST_DUE
        GUARANTEE_FLAG

        /
        level=interval;


    input

        COLLATERAL_TYPE
        SENIORITY
        SECTOR
        REGION
        ECONOMIC_SEGMENT

        /
        level=nominal;


    partition
        rolevar=ROLE(
            train="TRAIN"
            test="TEST"
        );


    score
        out=work.rf_scored;

run;


/* Keep TEST */

data work.score_rf;

    set work.rf_scored;


    if ROLE="TEST";


    LGD_PRED=.;


    /* Standard SAS prediction name */

    if
        missing(LGD_PRED)
        and
        not missing(P_LGD_OBS)

    then
        LGD_PRED=P_LGD_OBS;


    /*
       Source fallbacks for SAS-build naming differences.
    */

    if
        missing(LGD_PRED)
        and
        not missing(PREDICT)

    then
        LGD_PRED=PREDICT;


    if
        missing(LGD_PRED)
        and
        not missing(P_lgd_obs)

    then
        LGD_PRED=P_lgd_obs;


    length Model $30;

    Model =
