   SOURCE-BASED TEACHING MASTER:
   Consolidates the Section 4 SAS files supplied in the course.
==============================================================================*/


options
    mprint
    mlogic
    symbolgen
    nodate
    nonumber;

ods graphics on;


/*==============================================================================
   0. GLOBAL SETTINGS
==============================================================================*/

%let path =
    /home/u49308301/UDEMY_LESSONS/Lession1/Module4/;

%let input_file =
    &path./Lifetime_PD_Enriched.xlsx;


/* ECL assumptions */

%let HORIZON_M  = 60;
%let PD12_HORIZ = 12;

%let LGD_MODE   = CONST;
%let LGD_CONST  = 0.45;

%let EIR_ANNUAL = 0.12;


/* Cohort stability requirements */

%let MIN_LOANS  = 20;
%let MIN_EVENTS = 5;


/*==============================================================================
   1. IMPORT MONTHLY LOAN PANEL
==============================================================================*/

proc import
    datafile="&input_file."
    out=work.raw_panel
    dbms=xlsx
    replace;

    getnames=yes;

run;


/* Inspect dataset */

proc contents
    data=work.raw_panel
    order=varnum;

run;


proc means
    data=work.raw_panel
    n
    nmiss
    mean
    std
    min
    median
    max;

    var
        loan_age_m
        balance
        dpd
        ltv_utd
        unemp
        rate;

run;


/*==============================================================================
   2. PREPARE MONTHLY PANEL
==============================================================================*/

/*
   TIME VARIABLE

   Preferred:
       loan_age_m

   Fallback:
       months between origination_date and report_date
*/


data work.panel;

    set work.raw_panel;


    /*--------------------------------------------------------------
      Time on book
    --------------------------------------------------------------*/

    if not missing(loan_age_m)
    then
        time_m = loan_age_m;

    else if
        not missing(origination_date)
        and
        not missing(report_date)

    then
        time_m =
            intck(
                'month',
                origination_date,
                report_date,
                'c'
            );


    /* Remove impossible negative durations */

    if time_m < 0
    then delete;


    /*--------------------------------------------------------------
      Default event
      Production-like definition used in Cox portion:
         90+ DPD OR explicit default flag
    --------------------------------------------------------------*/

    event_default_90 =
        (
            dpd >= 90
            or
            default_flag = 1
        );


    /*--------------------------------------------------------------
      Non-default exits
    --------------------------------------------------------------*/

    closed_flag =
        (
            balance <= 0
            or
            months_to_maturity <= 0
        );


run;


/* Sort longitudinally */

proc sort
    data=work.panel;

    by
        cust_id
        time_m;

run;


/*==============================================================================
   3. EVENT / CENSOR CONSTRUCTION
==============================================================================*/

/*
   Survival analysis needs:

       T_i      = observed duration
       delta_i  = event indicator

   delta = 1 -> default
   delta = 0 -> censored

   Business logic:
       - first default only
       - no post-default exposure
       - non-default exit -> censor
*/


proc sql;

    create table work.loan_event as

    select

        cust_id,


        /* First observed default */

        min(
            case

                when event_default_90=1
                then time_m

                else .

            end
        )
        as t_event,


        /* First non-default exit */

        min(
            case

                when closed_flag=1
                then time_m

                else .

            end
        )
        as t_closed,


        /* Last observed period */

        max(time_m)
        as t_last


    from work.panel

    group by
        cust_id;

quit;


/*==============================================================================
   4. CREATE TIME-TO-EVENT DATASET
==============================================================================*/

data work.surv_one;

    set work.loan_event;


    /*--------------------------------------------------------------
      Default occurred before censoring
    --------------------------------------------------------------*/

    if
        not missing(t_event)
        and
        (
            missing(t_closed)
            or
            t_event <= t_closed
        )

    then do;

        time   = t_event;
        status = 1;

    end;


    /*--------------------------------------------------------------
      No default -> censored
    --------------------------------------------------------------*/

    else do;

        status = 0;

        time =
            min(
                t_closed,
                t_last
            );

        /*
           MIN() with missing values in SAS returns
           the smallest nonmissing argument.
        */

    end;


    /* Basic duration QA */

    if time < 0
    then delete;

run;


/*==============================================================================
   5. ADD BORROWER / MACRO COVARIATES
==============================================================================*/

/*
   Use information available before/event-at observation horizon.

   Here we take representative borrower fields for teaching purposes.
*/


proc sql;

    create table work.surv_model as

    select

        a.*,

        b.ltv_utd,
        b.unemp,
        b.rate


    from work.surv_one as a


    left join
    (
        select
            cust_id,

            mean(ltv_utd) as ltv_utd,
            mean(unemp)   as unemp,
            mean(rate)    as rate

        from work.panel

        group by cust_id

    ) as b


    on
        a.cust_id = b.cust_id;

quit;


/*==============================================================================
   6. CREATE LTV BANDS
==============================================================================*/

data work.surv_model;

    set work.surv_model;


    length ltv_band $20;


    if missing(ltv_utd)
    then
        ltv_band = "Missing";


    else if ltv_utd < 60
    then
        ltv_band = "<60";


    else if ltv_utd < 80
    then
        ltv_band = "60-80";


    else if ltv_utd < 100
    then
        ltv_band = "80-100";


    else
        ltv_band = "100+";


run;


/*==============================================================================
   7. KAPLAN-MEIER SURVIVAL
==============================================================================*/

proc lifetest
    data=work.surv_model
    plots=survival(cb=hw);

    time
        time*status(0);

    strata
        ltv_band;

    ods output
        ProductLimitEstimates=work.km_out;

run;


/*==============================================================================
   8. SURVIVAL -> LIFETIME PD
==============================================================================*/

/*
      Survival:

          S(t) = P(T > t)

      Cumulative PD:

          CumPD(t) = 1 - S(t)

      Marginal / interval PD:

          PD_t = S(t-1) - S(t)
*/


proc sort
    data=work.km_out;

    by
        ltv_band
        time;

run;


data work.km_pd;

    set work.km_out;

    by
        ltv_band
        time;


    retain S_prev;


    if first.ltv_band
    then
        S_prev = 1;


    if not missing(Survival)
    then do;


        PD_interval =
            max(
                0,
                S_prev - Survival
            );


        CumPD =
            1 - Survival;


        S_prev =
            Survival;


    end;


run;


/*==============================================================================
   9. COX PROPORTIONAL HAZARDS MODEL
==============================================================================*/

/*
   Cox model:

        h(t|X)
          =
        h0(t) * exp(X beta)

   Covariates:
        LTV
        unemployment
        interest rate

   Stratification:
        LTV band

   Censoring:
        status(0)

   Ties:
        Efron
*/


proc phreg
    data=work.surv_model
    plots(overlay)=survival;


    strata
        ltv_band;


    model
        time*status(0)
        =
        ltv_utd
        unemp
        rate

        /
        ties=efron;


    baseline
        out=work.cox_base
        survival=S
        cumhaz=cumH;


run;


/*==============================================================================
   OPTIONAL: COUNTING-PROCESS COX FORMAT
==============================================================================*/

/*
   This is the preferred structure when predictors change over time.

       one row = one loan × one interval

   Slide form:

       (start_t,end_t)*default_flag(0)
*/


proc sort
    data=work.panel
    out=work.panel_sorted;

    by
        cust_id
        time_m;

run;


data work.cox_panel;

    set work.panel_sorted;

    by cust_id;


    retain start_t
           default_seen;


    if first.cust_id
    then do;

        start_t      = 0;
        default_seen = 0;

    end;


    end_t =
        start_t + 1;


    default_event = 0;


    /* First default only */

    if
        event_default_90=1
        and
        default_seen=0

    then do;

        default_event = 1;
        default_seen   = 1;

    end;


    /* Output only through first default */

    if default_seen=0
       or
       default_event=1
    then output;


    start_t =
        end_t;

run;


/* Time-varying Cox */

proc phreg
    data=work.cox_panel;


    model
        (start_t,end_t)
        *default_event(0)
        =
        ltv_utd
        unemp
        rate

        /
        ties=efron;


    id
        cust_id;


    baseline
        out=work.cox_panel_base
        survival=S
        cumhaz=cumH;


run;


