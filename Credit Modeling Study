/**************************************************************************
 CHAPTER 2 — IFRS 9 POINT-IN-TIME PD MODELLING
 End-to-End SAS Workflow

 Pipeline:
 1. Load Data
 2. Data Quality
 3. Development / Validation Split
 4. Feature Engineering
 5. Logistic Regression
 6. PIT PD Generation
 7. Model Validation: AUC + KS
 8. PD Calibration
 9. IFRS 9 Staging
10. Expected Credit Loss (ECL)

 Target:
    default_flag = 1 if default within 12 months
                   0 otherwise
**************************************************************************/

options nodate nonumber;
ods graphics on;


/**************************************************************************
 0. SET PATHS
**************************************************************************/

%let path = /home/user/credit_risk;

libname cr "&path";


/**************************************************************************
 1. LOAD DATA
**************************************************************************/

proc import
    datafile="&path./credit_risk_data.csv"
    out=cr.raw_credit
    dbms=csv
    replace;
    guessingrows=max;
    getnames=yes;
run;


/* Inspect structure */

proc contents data=cr.raw_credit;
run;


/* First observations */

proc print data=cr.raw_credit(obs=20);
run;


/**************************************************************************
 2. BASIC DATA PREPARATION
**************************************************************************/

data cr.credit_clean;

    set cr.raw_credit;

    /* ---------------------------------------
       Create unique account identifier
       --------------------------------------- */

    if missing(account_id) then
        account_id = _N_;


    /* ---------------------------------------
       Date handling
       --------------------------------------- */

    format report_date date9.;


    /* ---------------------------------------
       Example business rules
       --------------------------------------- */

    if age < 18 then age = .;

    if dpd < 0 then dpd = .;


    /* ---------------------------------------
       Example derived variables
       --------------------------------------- */

    /* Debt-to-income ratio */

    if income > 0 then
        dti = total_debt / income;


    /* Utilization */

    if credit_limit > 0 then
        utilization = balance / credit_limit;


    /* Loan-to-value */

    if collateral_value > 0 then
        ltv = loan_balance / collateral_value;

run;


/**************************************************************************
 3. DATA QUALITY CHECKS
**************************************************************************/

/*-----------------------------------------------------------------------
 3.1 Missing values
 -----------------------------------------------------------------------*/

proc means data=cr.credit_clean
    n nmiss mean std min p25 median p75 max;
    var age income
        loan_balance
        total_debt
        dti
        utilization
        ltv
        dpd;
run;


/*-----------------------------------------------------------------------
 3.2 Frequency checks
 -----------------------------------------------------------------------*/

proc freq data=cr.credit_clean;

    tables
        default_flag
        employment_status
        product_type
        region
        / missing;

run;


/*-----------------------------------------------------------------------
 3.3 Duplicate account check
 -----------------------------------------------------------------------*/

proc sort
    data=cr.credit_clean
    out=cr.credit_sorted
    nodupkey
    dupout=cr.duplicates;

    by account_id report_date;

run;


/*-----------------------------------------------------------------------
 3.4 Outlier diagnostics
 -----------------------------------------------------------------------*/

proc univariate data=cr.credit_sorted;

    var
        income
        loan_balance
        dti
        utilization
        ltv;

    histogram;

run;


/**************************************************************************
 4. FEATURE ENGINEERING
**************************************************************************/

data cr.model_data;

    set cr.credit_sorted;


    /**********************************************************************
     Behavioural risk features
    **********************************************************************/

    if dpd = 0 then delinquency_band = 0;
    else if dpd <= 30 then delinquency_band = 1;
    else if dpd <= 60 then delinquency_band = 2;
    else delinquency_band = 3;


    /**********************************************************************
     DTI bands
    **********************************************************************/

    if dti < 0.20 then dti_band = 1;
    else if dti < 0.40 then dti_band = 2;
    else if dti < 0.60 then dti_band = 3;
    else dti_band = 4;


    /**********************************************************************
     Utilization bands
    **********************************************************************/

    if utilization < 0.30 then util_band = 1;
    else if utilization < 0.60 then util_band = 2;
    else if utilization < 0.90 then util_band = 3;
    else util_band = 4;


    /**********************************************************************
     LTV bands
    **********************************************************************/

    if ltv < 0.50 then ltv_band = 1;
    else if ltv < 0.75 then ltv_band = 2;
    else if ltv < 0.90 then ltv_band = 3;
    else ltv_band = 4;

run;

/**************************************************************************
 5. DEVELOPMENT / VALIDATION SPLIT
**************************************************************************/

proc surveyselect
    data=cr.model_data
    out=cr.model_split
    method=srs
    samprate=0.70
    seed=2026
    outall;
run;


data cr.development
     cr.validation;

    set cr.model_split;

    if selected = 1 then
        output cr.development;
    else
        output cr.validation;

run;


/* Check default rates */

proc freq data=cr.development;
    tables default_flag;
run;

proc freq data=cr.validation;
    tables default_flag;
run;

/**************************************************************************
 6. WOE / IV
**************************************************************************/

proc sql;

    create table cr.dti_counts as

    select
        dti_band,

        sum(default_flag = 0) as good,
        sum(default_flag = 1) as bad

    from cr.development

    group by dti_band;

quit;


/* Total good / bad */

proc sql;

    select
        sum(good),
        sum(bad)

    into
        :total_good,
        :total_bad

    from cr.dti_counts;

quit;


data cr.dti_woe;

    set cr.dti_counts;

    pct_good = good / &total_good;
    pct_bad  = bad  / &total_bad;

    if pct_good > 0 and pct_bad > 0 then
        woe = log(pct_good / pct_bad);

    iv_component =
        (pct_good - pct_bad) * woe;

run;


/* Total Information Value */

proc sql;

    select
        sum(iv_component)
        as IV

    from cr.dti_woe;

quit;

/**************************************************************************
 7. MACROECONOMIC OVERLAY
**************************************************************************/

proc sort data=cr.development_woe;
    by report_date;
run;

proc sort data=cr.macro_data;
    by report_date;
run;


data cr.development_pit;

    merge
        cr.development_woe(in=a)
        cr.macro_data(in=b);

    by report_date;

    if a;

run;

/**************************************************************************
 8. LOGISTIC REGRESSION — PIT PD MODEL
**************************************************************************/

proc logistic
    data=cr.development_pit
    descending
    outmodel=cr.pd_model;

    class
        employment_status
        product_type
        region
        / param=ref;

    model default_flag =

        dti_woe
        utilization
        ltv
        dpd

        age
        income

        GDP_growth
        unemployment_rate
        interest_rate

        / lackfit
          outroc=cr.roc_dev;

    output
        out=cr.dev_scored
        p=raw_pd;

run;

/**************************************************************************
 9. OUT-OF-SAMPLE SCORING
**************************************************************************/

proc logistic
    inmodel=cr.pd_model;

    score
        data=cr.validation
        out=cr.validation_scored;

run;

/**************************************************************************
 10. AUC / ROC VALIDATION
**************************************************************************/

proc logistic
    data=cr.validation_scored
    plots(only)=roc;

    model default_flag(event='1') = raw_pd;

    roc 'PIT PD Model' raw_pd;

run;

/**************************************************************************
 11. KS STATISTIC
**************************************************************************/

proc sort
    data=cr.validation_scored
    out=cr.ks_data;

    by descending raw_pd;

run;


/* Total defaults / non-defaults */

proc sql;

    select
        sum(default_flag),
        sum(1-default_flag)

    into
        :total_bad,
        :total_good

    from cr.ks_data;

quit;


data cr.ks_curve;

    set cr.ks_data;

    retain
        cum_bad 0
        cum_good 0;

    if default_flag = 1 then
        cum_bad + 1;

    else
        cum_good + 1;


    bad_cdf =
        cum_bad / &total_bad;

    good_cdf =
        cum_good / &total_good;


    ks =
        abs(bad_cdf - good_cdf);

run;


proc sql;

    select
        max(ks)
        format=percent8.2
        as KS_Statistic

    from cr.ks_curve;

quit;

/**************************************************************************
 12. PD CALIBRATION
**************************************************************************/

proc sql;

    select
        mean(default_flag),
        mean(raw_pd)

    into
        :observed_dr,
        :average_pd

    from cr.validation_scored;

quit;


/* Calibration multiplier */

%let calibration_factor =
    %sysevalf(
        &observed_dr /
        &average_pd
    );


data cr.calibrated_pd;

    set cr.validation_scored;

    calibrated_pd =
        raw_pd *
        &calibration_factor;


    /* Probability cannot exceed 100% */

    calibrated_pd =
        min(
            max(calibrated_pd,0),
            1
        );

run;

/**************************************************************************
 13. IFRS 9 STAGING
**************************************************************************/

data cr.staged_portfolio;

    set cr.calibrated_pd;


    /* Relative PD deterioration */

    if origination_pd > 0 then

        pd_ratio =
            calibrated_pd /
            origination_pd;


    /**********************************************************************
     STAGE 3
     Credit impaired / default
    **********************************************************************/

    if default_flag = 1
       or dpd >= 90 then

        stage = 3;


    /**********************************************************************
     STAGE 2
     Significant Increase in Credit Risk
    **********************************************************************/

    else if
        pd_ratio >= 2
        or dpd >= 30 then

        stage = 2;


    /**********************************************************************
     STAGE 1
    **********************************************************************/

    else

        stage = 1;

run;

     if stage = 1 then
    ecl_pd = calibrated_pd;
     data cr.staged_portfolio;

    set cr.staged_portfolio;

    if stage = 1 then
        ecl_pd = calibrated_pd;

    else if stage in (2,3) then
        ecl_pd = lifetime_pd;

run;

/**************************************************************************
 15. EXPECTED CREDIT LOSS
**************************************************************************/

data cr.ecl_account;

    set cr.staged_portfolio;


    /**********************************************************************
     Exposure at Default
    **********************************************************************/

    EAD =
        outstanding_balance
        +
        expected_drawdown;


    /**********************************************************************
     Discount factor
    **********************************************************************/

    DF =
        1 /
        ((1 + effective_interest_rate)
        ** time_to_loss);


    /**********************************************************************
     Expected Credit Loss
    **********************************************************************/

    ECL =
        ecl_pd
        *
        LGD
        *
        EAD
        *
        DF;

run;

/**************************************************************************
 16. MACRO SCENARIO ECL
**************************************************************************/

data cr.scenario_ecl;

    set cr.ecl_account;


    /* Scenario-specific PD */

    PD_base     = calibrated_pd;
    PD_upside   = calibrated_pd * 0.70;
    PD_downside = calibrated_pd * 1.40;
    PD_severe   = calibrated_pd * 2.20;


    /* Cap at 100% */

    PD_base     = min(PD_base,1);
    PD_upside   = min(PD_upside,1);
    PD_downside = min(PD_downside,1);
    PD_severe   = min(PD_severe,1);


    /* ECL by scenario */

    ECL_base =
        PD_base * LGD * EAD * DF;

    ECL_upside =
        PD_upside * LGD * EAD * DF;

    ECL_downside =
        PD_downside * LGD * EAD * DF;

    ECL_severe =
        PD_severe * LGD * EAD * DF;


    /**********************************************************************
     Probability-weighted ECL

     Example weights from chapter:
       Base       50%
       Upside     15%
       Downside   25%
       Severe     10%
    **********************************************************************/

    final_ECL =

          0.50 * ECL_base

        + 0.15 * ECL_upside

        + 0.25 * ECL_downside

        + 0.10 * ECL_severe;

run;

/**************************************************************************
 17. PORTFOLIO ECL REPORT
**************************************************************************/

proc sql;

    create table cr.ecl_summary as

    select

        stage,

        count(*) as Accounts,

        sum(EAD)
            format=dollar18.2
            as Total_EAD,

        mean(ecl_pd)
            format=percent8.2
            as Avg_PD,

        mean(LGD)
            format=percent8.2
            as Avg_LGD,

        sum(final_ECL)
            format=dollar18.2
            as Total_ECL

    from cr.scenario_ecl

    group by stage;

quit;


proc print data=cr.ecl_summary;
run;

