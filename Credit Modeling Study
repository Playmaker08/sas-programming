    data=work.with_orig_pd;

    tables
        default_flag
        stage
        /
        missing;

run;


title;


/*==============================================================================
  4. IFRS 9 STAGING — SOURCE-FAITHFUL MACRO-FREE IMPLEMENTATION
==============================================================================*/

/*
  Classroom staging rules supplied in Evaluation A:

  STAGE 3:
      Default flag = 1
      OR DPD >= 90

  STAGE 2:
      DPD >= 30
      OR Current PD / Origination PD >= 2

  STAGE 1:
      Otherwise


  SICR proxy:

                    Current PIT PD
      PD Ratio = ---------------------
                    Origination PD
*/


data work.staged_lite;

    set work.with_orig_pd;


    length
        stage $6
        stage_reason $60;


    /*----------------------------------------------------------------------
      Defensive type conversion: DPD
    ----------------------------------------------------------------------*/

    if vtype(dpd)='C'
    then
        dpd_n =
            input(
                strip(dpd),
                best12.
            );

    else
        dpd_n =
            dpd;


    /*----------------------------------------------------------------------
      Defensive type conversion: default flag
    ----------------------------------------------------------------------*/

    if vtype(default_flag)='C'
    then
        default_flag_n =

            (
                upcase(
                    strip(default_flag)
                )

                in
                (
                    '1',
                    'Y',
                    'YES',
                    'TRUE'
                )
            );

    else
        default_flag_n =
            (default_flag=1);


    /*----------------------------------------------------------------------
      Relative PD deterioration
    ----------------------------------------------------------------------*/

    if missing(pd12m_orig)
       or pd12m_orig<=0
    then
        pd_ratio=.;

    else
        pd_ratio =
            pit_pd_12m
            /
            pd12m_orig;


    /*----------------------------------------------------------------------
      STAGE 3
    ----------------------------------------------------------------------*/

    if default_flag_n=1
       or dpd_n>=90
    then do;

        stage='3';

        stage_reason=
            'Default or DPD>=90';

    end;


    /*----------------------------------------------------------------------
      STAGE 2
    ----------------------------------------------------------------------*/

    else if dpd_n>=30
         or pd_ratio>=2
    then do;

        stage='2';

        stage_reason=
            'SICR proxy (DPD>=30 or PD_ratio>=2)';

    end;


    /*----------------------------------------------------------------------
      STAGE 1
    ----------------------------------------------------------------------*/

    else do;

        stage='1';

        stage_reason=
            'No SICR';

    end;


    /*----------------------------------------------------------------------
      Standardise variables used downstream
    ----------------------------------------------------------------------*/

