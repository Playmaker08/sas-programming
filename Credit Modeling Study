/*==============================================================================
   6. MODE IMPUTATION FOR CATEGORICAL VARIABLES
==============================================================================*/

/*
   Mode(X) = most frequent category.

   Workflow:

       PROC SQL
            |
            v
       Frequency table
            |
            v
       Macro variable containing mode
            |
            v
       Replace missing categorical value
*/


%macro impute_mode_base(

    in=work.demo_missing,

    out=work.mode_imp,

    catvars=&cat_vars
);


    /* Start with original dataset */

    data &out.;
        set &in.;
    run;


    %local i v;

    %let i=1;


    %do %while(%scan(&catvars.,&i.) ne );

        %let v=%scan(&catvars.,&i.);


        /*---------------------------------------------------------
          Find most common category
        ---------------------------------------------------------*/

        proc sql noprint;

            create table _freq_&v. as

            select
                &v.,
                count(*) as cnt

            from &in.

            where not missing(&v.)

            group by &v.

            order by cnt desc;


            select &v.

            into :mode_&v. trimmed

            from _freq_&v.(obs=1);

        quit;


        /*---------------------------------------------------------
          Replace missing with mode
        ---------------------------------------------------------*/

        data &out.;
            set &out.;

            length &v._imp $40;

            &v._imp = &v.;

            if missing(&v._imp)
            then
                &v._imp = "&&mode_&v.";

        run;


        /* Cleanup */

        proc datasets
            lib=work
            nolist;

            delete _freq_&v.;

        quit;


        %let i=%eval(&i.+1);

    %end;

%mend;


%impute_mode_base();


