data work.cohort_pd;

    set work.cohort_km;

    by
        cohort
        time;


    retain S_prev;


    if first.cohort
    then
        S_prev=1;


    if not missing(Survival)
    then do;


        PD_interval =
            max(
                0,
                S_prev-Survival
            );


        CumPD =
            1-Survival;


        S_prev =
            Survival;


    end;


run;


/*==============================================================================
   18. 12M PD VS LIFETIME PD BY COHORT
==============================================================================*/

proc sql;


    create table work.cohort_pd_summary as


    select

        cohort,


        sum(
            case

                when time <= &PD12_HORIZ.
                then PD_interval

                else 0

            end
        )
        as PD_12M,


        max(CumPD)
        as PD_Lifetime


    from work.cohort_pd


    group by
        cohort;


quit;


/*==============================================================================
   19. ECL ENGINE — BUILD PORTFOLIO TIME-TO-EVENT DATA
==============================================================================*/

/*
   The supplied ECL code uses a portfolio KM survival curve.

   IMPORTANT:
   This is effectively a no-covariate survival model,
   NOT borrower-specific Cox predictions.
*/


proc sort
    data=work.panel
    out=work.ecl_panel;

    by
        cust_id
        time_m;

run;


data work.tte;

    set work.ecl_panel;

    by cust_id;


    retain
        _event_seen
        _tte;


    if first.cust_id
    then do;

        _event_seen=0;
        _tte=.;

    end;


    /*
       COURSE ECL DEMO:
       uses 30+ DPD event.

       This is preserved from source code.
    */

    if
        dpd >= 30
        and
        _event_seen=0

    then do;

        _event_seen=1;
        _tte=time_m;

    end;


    if last.cust_id
    then do;


        if _event_seen=1
        then do;

            tte_m=_tte;
            event=1;

        end;


        else do;

            tte_m=time_m;
            event=0;

        end;


        output;


    end;


    keep
        cust_id
        tte_m
        event;


run;


/*==============================================================================
   20. PORTFOLIO KAPLAN-MEIER SURVIVAL
==============================================================================*/

proc lifetest
    data=work.tte
    noprint
    outsurv=work.km_portfolio;


    time
        tte_m*event(0);


run;


/*==============================================================================
   21. CREATE MONTH GRID
==============================================================================*/

data work.months;

    do t=1 to &HORIZON_M.;

        output;

    end;

run;


/*==============================================================================
   22. FORWARD-FILL SURVIVAL CURVE
==============================================================================*/

proc sql;


    create table work.surv_grid as


    select

        m.t,

        k.survival as S_km


    from work.months as m


    left join work.km_portfolio as k


    on
        m.t = k.tte_m


    order by
        m.t;


quit;


data work.pd_curve;

    set work.surv_grid;


    retain
        S
        S_prev;


    if _N_=1
    then do;

        S      = 1;
        S_prev = 1;

    end;


    if not missing(S_km)
    then
        S=S_km;


    /* Marginal PD */

    PD_t =
        max(
            0,
            S_prev-S
        );


    /* Cumulative PD */

    CumPD_t =
        1-S;


    S_prev =
        S;


    keep
        t
        S
        PD_t
        CumPD_t;


run;


/*==============================================================================
   23. CREATE CUSTOMER × MONTH GRID
==============================================================================*/

proc sql;


    create table work.cust_list as


    select distinct
        cust_id


    from work.ecl_panel;


    create table work.calendar as


    select

        a.cust_id,

        b.t


    from
        work.cust_list as a,

        work.months as b;


quit;


/*==============================================================================
   24. BUILD EAD TERM STRUCTURE
==============================================================================*/

/*
   Observed balance where available.

   If future balance unavailable:
       forward-fill last observed balance.

   This follows the supplied teaching implementation.
*/


proc sql;


    create table work.balance_obs as


    select

        cust_id,

        time_m as t,

        balance as bal


    from work.ecl_panel;


quit;


proc sort
    data=work.calendar;

    by
        cust_id
        t;

run;


proc sort
    data=work.balance_obs;

    by
        cust_id
        t;

run;


data work.ead_curve;


    merge

        work.calendar(in=a)

        work.balance_obs;


    by
        cust_id
        t;


    if a;


    retain
        last_bal;


    if first.cust_id
    then
        last_bal=.;


    if not missing(bal)
    then
        last_bal=bal;


    EAD_t =
        coalesce(
            bal,
            last_bal,
            0
        );


run;


/*==============================================================================
   25. LGD TERM STRUCTURE
==============================================================================*/

proc sql;


    create table work.loan_ltv as


    select

        cust_id,

        mean(ltv_utd)
        as ltv_utd


    from work.ecl_panel


    group by
        cust_id;


quit;


proc sql;


    create table work.lgd_curve as


    select

        c.cust_id,

        c.t,

        l.ltv_utd


    from work.calendar as c


    left join work.loan_ltv as l


    on
        c.cust_id=l.cust_id;


quit;


data work.lgd_curve;

    set work.lgd_curve;


    /*--------------------------------------------------------------
      Constant LGD
    --------------------------------------------------------------*/

    %if %upcase(&LGD_MODE.)=CONST
    %then %do;


        LGD_t =
            &LGD_CONST.;


    %end;


    /*--------------------------------------------------------------
      LTV-based course/demo LGD
    --------------------------------------------------------------*/

    %else %do;


        LGD_t =

            min(

                0.90,

                max(

                    0.20,

                    0.20
                    +
                    0.006*ltv_utd

                )

            );


    %end;


run;


/*==============================================================================
   26. DISCOUNT FACTOR TERM STRUCTURE
==============================================================================*/

data work.discount_curve;


    set work.months;


    r_m =
        &EIR_ANNUAL./12;


    DF_t =
        (1+r_m)**(-t);


    keep
        t
        DF_t;


run;


/*==============================================================================
   27. BUILD MONTHLY ECL CUBE
==============================================================================*/

/*
   ECL_i,t = PD_t × LGD_i,t × EAD_i,t × DF_t
*/


proc sql;


    create table work.ecl_cube as


    select

        e.cust_id,

        e.t,


        p.PD_t,

        p.CumPD_t,

        l.LGD_t,

        e.EAD_t,

        d.DF_t,


        (
            p.PD_t
            *
            l.LGD_t
            *
            e.EAD_t
            *
            d.DF_t
        )
        as ECL_t


    from work.ead_curve as e


    left join work.pd_curve as p

        on
            e.t=p.t


    left join work.lgd_curve as l

        on
            e.cust_id=l.cust_id
            and
            e.t=l.t


    left join work.discount_curve as d

        on
            e.t=d.t


    order by

        e.cust_id,

        e.t;


quit;


/*==============================================================================
   28. AGGREGATE 12-MONTH AND LIFETIME ECL
==============================================================================*/

proc sql;


    create table work.ecl_summary as


    select

        cust_id,


        sum(

            case

                when t <= &PD12_HORIZ.

                then ECL_t

                else 0

            end

        )
        as ECL_12M,


        sum(ECL_t)
        as ECL_Lifetime


    from work.ecl_cube


    group by
        cust_id;


quit;


