quit;


/*==============================================================================
===============================================================================
                    METHOD 7
                FRACTIONAL LOGIT
===============================================================================
==============================================================================*/


/*
   Fractional response:

   E(LGD|X) = logistic(X beta)

                      1
             = ----------------
               1 + exp(-X beta)


   Quasi log-likelihood:

   LL_i =
       y_i log(mu_i)
       +
       (1-y_i) log(1-mu_i)
*/


proc nlmixed
    data=work.lgd_train
    tech=newrap
    maxiter=200;


    parms

        b0=0
        b1=0.3
        b2=0
        b3=0
        b4=-0.1;


    eta =

        b0
        +
        b1*LTV
        +
        b2*INTEREST_RATE
        +
        b3*DAYS_PAST_DUE
        +
        b4*GUARANTEE_FLAG;


    mu =
        1/
        (
            1+
            exp(-eta)
        );


    ll =

        y_frac*log(mu)

        +

        (1-y_frac)
        *log(1-mu);


    model
        y_frac ~ general(ll);


    ods output
        ParameterEstimates=
            work.frlogit_params;

run;


/*---------------------------------------------------------------------------
   Extract frozen TRAIN coefficients
---------------------------------------------------------------------------*/

proc sql noprint;


    select Estimate
    into :fr_b0

    from work.frlogit_params

    where Parameter="b0";


    select Estimate
    into :fr_b1

    from work.frlogit_params

    where Parameter="b1";


    select Estimate
    into :fr_b2

    from work.frlogit_params

    where Parameter="b2";


    select Estimate
    into :fr_b3

    from work.frlogit_params

    where Parameter="b3";


    select Estimate
    into :fr_b4

    from work.frlogit_params

    where Parameter="b4";


quit;


/* Score TEST */

data work.score_fractional;

    set work.lgd_test;


    eta =

        &fr_b0.
        +
        &fr_b1.*LTV
        +
        &fr_b2.*INTEREST_RATE
        +
        &fr_b3.*DAYS_PAST_DUE
        +
        &fr_b4.*GUARANTEE_FLAG;


    LGD_PRED =

        1/
        (
            1+
            exp(-eta)
        );


    length Model $30;

    Model =
        "Fractional Logit";

run;


/* Evaluate */

proc sql;

    create table work.metric_fractional as

    select

        "Fractional Logit"
            as Model length=30,

